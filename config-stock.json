{
  "database": {
    "host": "set-with-DB_HOST",
    "port": 3306,
    "user": "set-with-DB_USER",
    "password": "set-with-DB_PASSWORD",
    "database": "set-with-DB_DATABASE"
  },
  "otp": { "allowedAttempts": 5, "validMinutes": 15 },
  "passwordReset": { "validMinutes": 60 },
  "session": { "validMinutes": 15, "refreshToken": 480 },
  "clientUrl": "set-with-CLIENT_URL",
  "secret": "set-with-JWT_SECRET",
  "smtpOptions": {
    "emailFrom": "set-with-SMTP_FROM",
    "host": "set-with-SMTP_HOST",
    "port": 587,
    "auth": { "user": "set-with-SMTP_USER", "pass": "set-with-SMTP_PASS" }
  }
}
