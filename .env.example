NODE_ENV=production
PORT=8080
CLIENT_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
JWT_SECRET=replace-with-a-64-character-random-secret
CSRF_SECRET=replace-with-a-different-64-character-random-secret
JITSI_JWT_SECRET=replace-with-a-different-64-character-random-secret
DB_HOST=database.example.com
DB_PORT=3306
DB_USER=vofapi
DB_PASSWORD=replace-with-a-secret-manager-value
DB_DATABASE=vofapi
SMTP_HOST=email-smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-a-secret-manager-value
SMTP_PASS=replace-with-a-secret-manager-value
SMTP_FROM=VOF <noreply@example.com>
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=true
PASSWORD_BREACH_CHECK_REQUIRED=true
